DATABASE_URL=postgres://drew:drew@localhost:5433/drew
RUST_LOG=info,drew=debug
DREW_BIND=127.0.0.1:8080
# key:user_id pairs, comma-separated
DREW_API_KEYS=sk-local-drew:drew

# Bedrock: region and credentials come from the default AWS chain (AWS_PROFILE or AWS_ACCESS_KEY_ID, ...).
AWS_REGION=us-east-1
DREW_EMBED_MODEL=amazon.titan-embed-text-v2:0
DREW_EXPLAIN_MODEL=

# Sources: a source is ingested only when all of its variables are set.
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
DREW_CONFLUENCE_ACCOUNT_ID=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=
DREW_JIRA_ACCOUNT_ID=

# Bot scopes: channels:read, channels:history, users:read. Invite the bot to each channel.
SLACK_BOT_TOKEN=
SLACK_CHANNELS=
SLACK_WORKSPACE_URL=
DREW_SLACK_USER_ID=
