DATABASE_URL=postgres://drew:drew@localhost:5433/drew
RUST_LOG=info,drew=debug
DREW_BIND=127.0.0.1:8080
# key:user_id pairs, comma-separated
DREW_API_KEYS=sk-local-drew:drew
# Optional: user ids that may read any run (audit Slack/API traffic)
DREW_ADMIN_USERS=drew

# Models, all local: Ollama for embeddings and Explain, Kev for System One. See README, "Running fully locally".
DREW_EMBED_URL=http://localhost:11434/v1
DREW_EMBED_MODEL=bge-m3
DREW_EXPLAIN_URL=http://localhost:11434/v1
DREW_EXPLAIN_MODEL=qwen3:14b
DREW_SYSTEM_ONE_URL=http://127.0.0.1:8009

# Models on Bedrock instead: unset the two *_URL variables above. Region and credentials come from the default AWS chain.
# AWS_REGION=us-east-1
# DREW_EMBED_MODEL=amazon.titan-embed-text-v2:0
# DREW_EXPLAIN_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Corpus: Drew-audited markdown directory (required for ingest)
DREW_DOCS_DIR=
# Optional base URL for citation links (e.g. GitHub blob URL)
DREW_DOCS_BASE_URL=

# Slack bot (optional): both tokens required to enable Socket Mode in drew serve
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
